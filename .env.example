# Copy for manual setup, or run: bun run configure
# Use independent randomly generated values. Never commit .env.
DB_PASSWORD=replace-with-a-random-password
DATABASE_URL=postgres://haruflow:replace-with-a-random-password@127.0.0.1:5432/haruflow
HARUFLOW_SETUP_TOKEN=replace-with-at-least-32-random-characters
HARUFLOW_BIND=127.0.0.1:8080
HARUFLOW_PORT=8080
HARUFLOW_STATIC_DIR=apps/web/dist
# false is for localhost HTTP only. Set true when serving through HTTPS.
HARUFLOW_SECURE_COOKIES=false
RUST_LOG=haruflow=info,tower_http=info
